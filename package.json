{
  "name": "@ioventure/smartformio",
  "version": "1.0.0",
  "description": "A framework-agnostic dynamic form library with built-in validation and framework-specific wrappers",
  "main": "dist/smartformio.umd.js",
  "module": "dist/smartformio.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/global.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx tsc && node build.js",
    "dev": "node dev-server.js",
    "test": "jest --config jest.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "form",
    "web-components",
    "dynamic",
    "typescript",
    "react",
    "nextjs",
    "validation",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioventure/smartformio"
  },
  "author": "Shibu Shrivastava",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ioventure/smartformio/issues"
  },
  "homepage": "https://github.com/ioventure/smartformio#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
